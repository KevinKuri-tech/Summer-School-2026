# Copy to .env and fill in one key. No quotes, no trailing comments:
# the loader in studyplan/__init__.py reads plain KEY=value lines only.
#
# Pick ONE backend. With both keys set, OpenRouter is the preselected default.
# With no key at all the deterministic baseline planner runs, at zero cost.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Default: claude-sonnet-5
STUDYPLAN_ANTHROPIC_MODEL=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default: ~anthropic/claude-haiku-latest
STUDYPLAN_OPENROUTER_MODEL=

# Sign-in accounts. Leave empty for the built-in student1/2/3 roster.
# name:secret pairs separated by ; where secret is a password or, better, a
# digest from: uv run python -m studyplan.auth 'the password'
STUDYPLAN_USERS=
